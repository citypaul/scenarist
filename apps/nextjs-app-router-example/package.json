{
  "name": "@scenarist/nextjs-app-router-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "dev:logs": "SCENARIST_LOG=1 next dev --port 3002",
    "build": "next build",
    "build:production": "NODE_ENV=production next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:e2e",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:logs": "SCENARIST_LOG=1 playwright test --project=chromium",
    "test:custom": "SERVER_MODE=custom playwright test --project=chromium",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "verify:treeshaking": "pnpm build:production && ! grep -rE '(setupWorker|startWorker|http\\.(get|post|put|delete|patch)|HttpResponse\\.json)' .next/ --exclude-dir=cache"
  },
  "dependencies": {
    "@scenarist/nextjs-adapter": "workspace:*",
    "csrf": "^3.1.0",
    "msw": "^2.15.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@scenarist/eslint-config": "workspace:*",
    "@scenarist/playwright-helpers": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wait-on": "^5.3.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "express": "^5.2.1",
    "json-server": "1.0.0-beta.15",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  }
}
