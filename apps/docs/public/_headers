# Cloudflare static asset headers: https://developers.cloudflare.com/workers/static-assets/headers/

# LLM documentation (see src/utils/llms-txt.ts). llms.txt itself stays indexable.
# The bundles repeat the content of every docs page, so keep them out of search results.
/llms-full.txt
  X-Robots-Tag: noindex
/llms-small.txt
  X-Robots-Tag: noindex
/_llms-txt/*
  X-Robots-Tag: noindex
