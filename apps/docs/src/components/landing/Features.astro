---
import { Icon } from 'astro-icon/components';

const items = [
  {
    href: '/frameworks/nextjs/',
    icon: 'simple-icons:nextdotjs',
    title: 'Next.js',
    body: 'App Router and Pages Router. Server Components, Server Actions and route handlers run for real.',
  },
  {
    href: '/frameworks/express/getting-started/',
    icon: 'simple-icons:express',
    title: 'Express',
    body: 'Routes, middleware and error handlers run for real, with the same scenarios and fixtures.',
  },
  {
    href: '/testing/playwright-integration/',
    icon: 'simple-icons:playwright',
    title: 'Playwright fixtures',
    body: 'switchScenario with typed scenario IDs, and a unique test ID per test for parallel runs.',
  },
  {
    href: '/concepts/production-safety/',
    icon: null,
    title: '0 kB in production',
    body: 'Conditional exports swap in an empty module, so no test code ships to your users.',
  },
] as const;
---

<section class="px-6 py-24 border-t border-gray-100 dark:border-white/5">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white text-center mb-12 text-balance">
      Fits the stack you already have
    </h2>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-gray-200 dark:divide-white/10 border-y border-gray-200 dark:border-white/10">
      {items.map((item) => (
        <li>
          <a href={item.href} class="group block h-full p-6 hover:bg-gray-50 dark:hover:bg-white/[0.03] transition-colors">
            <span class="flex items-center gap-2.5 text-gray-900 dark:text-white">
              {item.icon ? (
                <Icon name={item.icon} class="w-5 h-5" />
              ) : (
                <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" stroke-linejoin="round" /><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              )}
              <span class="font-semibold">{item.title}</span>
            </span>
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{item.body}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-violet-700 dark:text-violet-400 group-hover:underline underline-offset-4">
              Docs <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
