---
// Glass navigation with logo, links, and CTA
---

<nav class="fixed w-full z-50 bg-white/80 dark:bg-[#0A0A0C]/70 backdrop-blur-[12px] border-b border-gray-200 dark:border-white/5 transition-colors">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <svg class="w-6 h-6 drop-shadow-[0_0_8px_rgba(139,92,246,0.5)]" viewBox="0 0 128 128" aria-hidden="true">
        <defs>
          <linearGradient id="nav-logo-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#a78bfa" /><stop offset="0.55" stop-color="#8b5cf6" /><stop offset="1" stop-color="#10b981" />
          </linearGradient>
        </defs>
        <path fill="url(#nav-logo-gradient)" fill-rule="evenodd" d="M81 36 64 0 47 36l-1 2-9-10a6 6 0 0 0-9 9l10 10h-2L0 64l36 17h2L28 91a6 6 0 1 0 9 9l9-10 1 2 17 36 17-36v-2l9 10a6 6 0 1 0 9-9l-9-9 2-1 36-17-36-17-2-1 9-9a6 6 0 1 0-9-9l-9 10v-2Zm-17 2-2 5c-4 8-11 15-19 19l-5 2 5 2c8 4 15 11 19 19l2 5 2-5c4-8 11-15 19-19l5-2-5-2c-8-4-15-11-19-19l-2-5Z" />
        <path fill="url(#nav-logo-gradient)" d="M118 19a6 6 0 0 0-9-9l-3 3a6 6 0 1 0 9 9l3-3Zm-96 4c-2 2-6 2-9 0l-3-3a6 6 0 1 1 9-9l3 3c3 2 3 6 0 9Zm0 82c-2-2-6-2-9 0l-3 3a6 6 0 1 0 9 9l3-3c3-2 3-6 0-9Zm96 4a6 6 0 0 1-9 9l-3-3a6 6 0 1 1 9-9l3 3Z" />
      </svg>
      <span class="font-bold tracking-tight text-lg text-gray-900 dark:text-white">Scenarist</span>
    </a>

    <!-- Navigation Links -->
    <div class="flex items-center gap-3 sm:gap-6 text-sm font-medium">
      <a
        href="#watch"
        class="hidden sm:inline text-gray-600 dark:text-gray-400 hover:text-primary transition"
      >
        Watch
      </a>
      <a
        href="/getting-started/quick-start/"
        class="text-gray-600 dark:text-gray-400 hover:text-primary transition"
      >
        Docs
      </a>
      
      <!-- Star on GitHub Button -->
      <a
        href="https://github.com/citypaul/scenarist"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Star on GitHub"
        class="flex items-center gap-1.5 px-3 py-1.5 bg-gray-900 dark:bg-white text-white dark:text-black rounded-lg hover:opacity-90 transition font-medium shadow-sm"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.921.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <span class="hidden sm:inline">Star</span>
      </a>

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-primary transition"
        aria-label="Toggle dark mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Theme toggle click handler
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('theme-toggle'));
  });
</script>
