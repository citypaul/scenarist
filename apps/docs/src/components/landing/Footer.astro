---
// Footer with CTA and links
const year = new Date().getFullYear();
---

<footer class="py-20 border-t border-gray-200 dark:border-white/5 text-center">
  <div class="max-w-2xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-gray-900 dark:text-white">
      Stop testing only the happy path.
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Your real server. Every scenario. One <code class="font-mono text-sm px-1.5 py-0.5 rounded bg-gray-100 dark:bg-white/10">switchScenario</code> call away.
    </p>

    <div class="flex justify-center gap-4 flex-wrap">
      <!-- Get Started CTA -->
      <a
        href="/getting-started/quick-start"
        class="px-8 py-3 bg-gray-900 dark:bg-white text-white dark:text-black font-bold rounded-full hover:opacity-90 transition shadow-lg"
      >
        Get Started
      </a>

      <!-- Watch CTA -->
      <a
        href="#watch"
        class="px-8 py-3 bg-violet-600 text-white font-bold rounded-full hover:bg-violet-700 transition shadow-lg shadow-violet-600/20"
      >
        Watch the tour
      </a>

      <!-- GitHub CTA -->
      <a
        href="https://github.com/citypaul/scenarist"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3 bg-white dark:bg-[#0A0A0C] border border-gray-200 dark:border-white/10 text-gray-900 dark:text-white font-bold rounded-full hover:bg-gray-50 dark:hover:bg-white/5 transition"
      >
        GitHub
      </a>
    </div>

    <div class="mt-12 text-gray-600 dark:text-gray-400 text-sm">
      &copy; {year} Scenarist. Released under MIT License.
    </div>
  </div>
</footer>
