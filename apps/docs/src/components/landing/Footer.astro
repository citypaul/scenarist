---
// Footer with CTA and links
const year = new Date().getFullYear();
---

<footer class="py-20 border-t border-gray-200 dark:border-white/5 text-center">
  <div class="max-w-2xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-gray-900 dark:text-white">
      Stop testing only the happy path.
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Your real server. Every scenario. One <code class="font-mono text-sm px-1.5 py-0.5 rounded bg-gray-100 dark:bg-white/10">switchScenario</code> call away.
    </p>

    <div class="flex justify-center items-center gap-3 flex-wrap">
      <a
        href="/getting-started/quick-start"
        class="px-6 py-3 bg-violet-600 text-white font-semibold rounded-lg hover:bg-violet-700 transition shadow-[0_10px_24px_-10px_rgba(124,58,237,0.7)]"
      >
        Get Started
      </a>
      <a
        href="#watch"
        class="px-6 py-3 border border-gray-300 dark:border-white/15 text-gray-900 dark:text-white font-semibold rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition"
      >
        Watch the tour
      </a>
      <a
        href="https://github.com/citypaul/scenarist"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-3 text-gray-700 dark:text-gray-300 font-semibold rounded-lg hover:text-violet-700 dark:hover:text-violet-300 transition"
      >
        GitHub →
      </a>
    </div>

    <div class="mt-12 text-gray-600 dark:text-gray-400 text-sm">
      &copy; {year} Scenarist. Released under MIT License.
    </div>
  </div>
</footer>
