---
type Mark = 'yes' | 'no' | 'partial';
type Row = { label: string; unit: Mark; e2e: Mark; scenarist: Mark };

const rows: readonly Row[] = [
  { label: 'Your real backend code runs', unit: 'no', e2e: 'yes', scenarist: 'yes' },
  { label: 'Any external scenario, on demand', unit: 'yes', e2e: 'no', scenarist: 'yes' },
  { label: 'No mocking next/headers or req.session', unit: 'no', e2e: 'yes', scenarist: 'yes' },
  { label: 'Deterministic, no shared sandbox state', unit: 'yes', e2e: 'no', scenarist: 'yes' },
  { label: 'Parallel tests with isolated state', unit: 'yes', e2e: 'partial', scenarist: 'yes' },
  { label: 'No third-party credentials in CI', unit: 'yes', e2e: 'no', scenarist: 'yes' },
  { label: 'Scripts calls made from the browser (e.g. Stripe.js)', unit: 'yes', e2e: 'no', scenarist: 'no' },
];

const heads = ['Unit tests + mocks', 'E2E against live services', 'Scenarist'] as const;

const label: Record<Mark, string> = { yes: 'Yes', no: 'No', partial: 'Partly' };
const markPath: Record<Mark, string> = { yes: 'M5 12.5l4.5 4.5L19 7.5', no: 'M7 7l10 10M17 7L7 17', partial: 'M6 12h12' };
---


<section id="compare" class="py-24 px-6 border-t border-gray-100 dark:border-white/5 scroll-mt-16">
  <svg class="hidden" aria-hidden="true">
    {(Object.keys(markPath) as Mark[]).map((mark) => (
      <symbol id={`cmp-${mark}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={markPath[mark]} /></symbol>
    ))}
  </svg>
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-gray-900 dark:text-white">
        Stop choosing between real code and real coverage
      </h2>
      <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Unit tests can fake any scenario, but your server never runs. End-to-end tests run your server, but only on the happy path.
        Scenarist gives you both.
      </p>
    </div>

    <ul class="md:hidden space-y-3">
      {rows.map((row) => (
        <li class="rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#0A0A0C] p-4">
          <p class="font-medium text-gray-900 dark:text-white mb-3">{row.label}</p>
          <dl class="grid grid-cols-3 gap-2 text-center">
            {[row.scenarist, row.unit, row.e2e].map((mark, i) => (
              <div class:list={['cmp-cell', i === 0 && 'cmp-cell-ours']}>
                <dt class="cmp-head">{[heads[2], heads[0], heads[1]][i]}</dt>
                <dd class={`cmp-mark cmp-${mark}`}>
                  <svg class="w-3.5 h-3.5" aria-hidden="true"><use href={`#cmp-${mark}`} /></svg>
                  {label[mark]}
                </dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>

    <div class="hidden md:block overflow-x-auto rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#0A0A0C]" tabindex="0" role="region" aria-label="Comparison of testing approaches">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-white/10">
            <th scope="col" class="p-4 md:p-5 font-medium text-gray-500 dark:text-gray-400"><span class="sr-only">Capability</span></th>
            <th scope="col" class="p-4 md:p-5 font-semibold text-gray-900 dark:text-white text-center">Unit tests + mocks</th>
            <th scope="col" class="p-4 md:p-5 font-semibold text-gray-900 dark:text-white text-center">E2E against live services</th>
            <th scope="col" class="p-4 md:p-5 font-bold text-violet-700 dark:text-violet-300 text-center bg-violet-50 dark:bg-violet-500/10">Scenarist</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b last:border-b-0 border-gray-100 dark:border-white/5">
              <th scope="row" class="p-4 md:p-5 font-medium text-gray-800 dark:text-gray-200">{row.label}</th>
              {[row.unit, row.e2e, row.scenarist].map((mark, i) => (
                <td class:list={['p-4 md:p-5 text-center', i === 2 && 'bg-violet-50/60 dark:bg-violet-500/[0.06]']}>
                  <span class={`cmp-mark justify-center gap-1.5 cmp-${mark}`}>
                    <svg class="w-3.5 h-3.5" aria-hidden="true"><use href={`#cmp-${mark}`} /></svg>
                    {label[mark]}
                  </span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-2xl mx-auto text-center text-sm text-gray-600 dark:text-gray-400">
      Comparing with MSW, Playwright route mocks, WireMock, Nock or Testcontainers?{' '}
      <a href="/comparison/" class="font-medium text-violet-700 dark:text-violet-400 hover:underline">See the detailed comparisons →</a>
    </p>
  </div>
</section>

<style is:global>
  @reference "../../styles/global.css";

  @layer components {
    .cmp-cell {
      @apply rounded-lg px-2 py-2 bg-gray-50 dark:bg-white/[0.03];
    }
    .cmp-cell-ours {
      @apply bg-violet-50 dark:bg-violet-500/10;
    }
    .cmp-head {
      @apply text-[12px] leading-tight text-gray-600 dark:text-gray-400 mb-1;
    }
    .cmp-mark {
      @apply inline-flex items-center gap-1 text-xs font-semibold;
    }
    .cmp-yes {
      @apply text-emerald-700 dark:text-emerald-400;
    }
    .cmp-no {
      @apply text-rose-700 dark:text-rose-400;
    }
    .cmp-partial {
      @apply text-amber-800 dark:text-amber-400;
    }
  }
</style>
