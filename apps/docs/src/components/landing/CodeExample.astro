---
// Highlighted at build time so the page never loads Shiki themes at runtime.
import { highlight } from './highlight';

const scenarioCode = `export const scenarios = {
  default: happyPath,
  paymentDeclined: {
    id: 'paymentDeclined',
    name: 'Card declined',
    description: 'Stripe rejects the charge',
    mocks: [{
      method: 'POST',
      url: 'https://api.stripe.com/v1/charges',
      response: {
        status: 402,
        body: { error: { code: 'card_declined' } },
      },
    }],
  },
} as const satisfies ScenaristScenarios;`;

const testCode = `test('declined card shows a friendly error', async ({
  page, switchScenario,
}) => {
  await switchScenario(page, 'paymentDeclined');

  await page.goto('/checkout');
  await page.getByLabel('Email').fill('ada@acme.test');
  await page.getByRole('button', { name: 'Pay' }).click();

  await expect(page.getByText('Payment failed')).toBeVisible();
});`;

const panels = [
  { file: 'scenarios.ts', note: 'Plain data. No functions, no framework mocks.', code: scenarioCode },
  { file: 'checkout.spec.ts', note: 'A real browser against your real server.', code: testCode },
];
---

<section class="relative z-10 px-6 pb-24">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mx-auto text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4 text-balance">
        Declare a scenario. Switch to it in any test.
      </h2>
      <p class="text-gray-600 dark:text-gray-400">
        Scenario IDs are typed, so <code class="font-mono text-[14px] text-gray-800 dark:text-gray-200">switchScenario</code> autocompletes
        every one you’ve defined. Each test gets its own, even when they run in parallel.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {panels.map((panel) => (
        <figure class="rounded-2xl bg-white dark:bg-[#0A0A0C] border border-gray-200 dark:border-white/10 overflow-hidden">
          <figcaption class="flex items-baseline justify-between gap-4 px-5 py-3 border-b border-gray-100 dark:border-white/5 bg-gray-50 dark:bg-white/[0.02]">
            <span class="font-mono text-[13px] font-semibold text-gray-900 dark:text-gray-100">{panel.file}</span>
            <span class="text-xs text-gray-600 dark:text-gray-400 text-right">{panel.note}</span>
          </figcaption>
          <pre
            class="p-5 font-mono text-[13px] leading-relaxed text-gray-800 dark:text-gray-200 whitespace-pre-wrap break-words xl:whitespace-pre xl:overflow-x-auto"
            tabindex="0"
            aria-label={`${panel.file} example`}
          ><code set:html={highlight(panel.code)} /></pre>
        </figure>
      ))}
    </div>
  </div>
</section>
