---
import { Icon } from 'astro-icon/components';
import PromoVideo from './PromoVideo.astro';
import pkg from '../../../../../packages/express-adapter/package.json';

const version = pkg.version;
const releasesUrl = 'https://github.com/citypaul/scenarist/releases';

const chapters = [
  { href: '#how-it-works', title: 'How it works', blurb: 'Browser → your server → scripted APIs' },
  { href: '#scenarios', title: 'Every scenario', blurb: 'The edge cases teams never test' },
  { href: '#dynamic', title: 'Dynamic scenarios', blurb: 'Interactive: state, sequences and matching', featured: true },
  { href: '#compare', title: 'Compare', blurb: 'vs unit tests and live-service E2E' },
];
---

<section class="relative z-10 pt-24 pb-16 lg:pb-20 px-6 overflow-hidden">
  <!-- Background Gradients -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl pointer-events-none">
    <div class="absolute top-20 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-3xl opacity-30 motion-safe:animate-pulse"></div>
    <div class="absolute top-40 right-1/4 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl opacity-25 motion-safe:animate-pulse delay-1000"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10 grid lg:grid-cols-2 xl:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-y-8 lg:gap-y-0 lg:gap-x-12 xl:gap-x-14">
    <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1 lg:self-end">
      <!-- Version Badge -->
      <a href={releasesUrl} class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-gray-200 dark:border-white/10 bg-white/80 dark:bg-white/5 backdrop-blur-sm text-xs font-mono text-violet-700 dark:text-primary mb-7 lg:mb-5 hover:border-primary/50 transition-colors">
        <span class="flex w-2 h-2 rounded-full bg-primary"></span>
        v{version} Available
      </a>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl lg:text-[3.5rem] font-extrabold tracking-tighter leading-[1.05] lg:mb-5">
        <span class="text-gray-900 dark:text-white">Test Reality.</span><br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-emerald-600 dark:from-violet-400 dark:to-emerald-400">Control the Rest.</span>
      </h1>
    </div>

    <div id="watch" class="w-full max-w-3xl mx-auto lg:max-w-none lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center scroll-mt-24">
      <PromoVideo />
    </div>

    <div class="text-center lg:text-left lg:col-start-1 lg:row-start-2 lg:self-start">

      <!-- Tagline -->
      <p class="text-lg md:text-xl lg:text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto lg:mx-0 mb-4 leading-relaxed">
        Playwright tests that hit your real server through a real browser. Your routes, middleware and business logic
        run for real;{' '}<span class="text-gray-900 dark:text-white font-semibold">Scenarist</span> scripts <em>only</em>{' '}
        the third-party APIs they call, per test.
      </p>
      <p class="text-base md:text-lg lg:text-base text-gray-900 dark:text-white font-medium max-w-2xl mx-auto lg:mx-0 mb-9 lg:mb-7">
        So you can finally test the declined card, the expired Auth0 session and the 503—not just the happy path.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col items-center lg:items-start gap-3">
        <!-- Framework + Package Manager Tabs -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
          <!-- Framework Selector -->
          <div class="flex items-center gap-1 p-1 bg-gray-100 dark:bg-[#1a1a1c] rounded-lg">
            <button
              data-framework="nextjs"
              class="framework-tab px-3 py-1.5 text-xs font-medium rounded-md transition-all bg-white dark:bg-[#27272A] text-gray-900 dark:text-white shadow-sm"
            >
              Next.js
            </button>
            <button
              data-framework="express"
              class="framework-tab px-3 py-1.5 text-xs font-medium rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
            >
              Express
            </button>
          </div>

          <!-- Package Manager Tabs -->
          <div class="flex items-center gap-1 p-1 bg-gray-100 dark:bg-[#1a1a1c] rounded-lg">
            <button
              data-pm="npm"
              class="pm-tab px-3 py-1.5 text-xs font-medium rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
            >
              npm
            </button>
            <button
              data-pm="pnpm"
              class="pm-tab px-3 py-1.5 text-xs font-medium rounded-md transition-all bg-white dark:bg-[#27272A] text-gray-900 dark:text-white shadow-sm"
            >
              pnpm
            </button>
            <button
              data-pm="yarn"
              class="pm-tab px-3 py-1.5 text-xs font-medium rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
            >
              yarn
            </button>
          </div>
        </div>

        <!-- Install Command + Get Started -->
        <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center lg:justify-start gap-3">
          <!-- Install Command -->
          <button
            id="copy-install"
            class="group flex max-w-full items-center gap-3 bg-white dark:bg-[#161618] border border-gray-200 dark:border-[#27272A] px-4 py-2.5 rounded-lg font-mono text-[13px] sm:text-sm whitespace-nowrap text-gray-700 dark:text-gray-300 cursor-pointer hover:border-primary/50 dark:hover:border-gray-500 hover:shadow-lg hover:shadow-primary/5 transition-all duration-300"
          >
            <span class="text-primary font-bold select-none">$</span>
            <span id="install-command" class="select-all">pnpm add @scenarist/nextjs-adapter msw</span>
            <div class="relative w-4 h-4 flex-shrink-0">
              <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 group-hover:text-primary transition-all absolute inset-0 opacity-100 group-[.copied]:opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg class="w-4 h-4 text-green-500 transition-all absolute inset-0 opacity-0 group-[.copied]:opacity-100 scale-50 group-[.copied]:scale-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
          </button>

          <!-- Get Started Button -->
          <a
            href="/getting-started/quick-start/"
            class="px-6 py-2.5 bg-violet-600 text-white font-semibold rounded-lg hover:bg-violet-700 motion-safe:hover:scale-105 transition-all duration-300 flex items-center gap-2 shadow-lg shadow-violet-600/20"
          >
            Get Started
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Framework Integrations -->
      <div class="mt-9 lg:mt-7 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">Built for</p>
        <div class="flex items-center gap-6">
          <a href="/frameworks/nextjs/" class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors">
            <Icon name="simple-icons:nextdotjs" class="w-5 h-5" />
            <span class="font-medium text-sm">Next.js</span>
          </a>
          <a href="/frameworks/express/getting-started/" class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors">
            <Icon name="simple-icons:express" class="w-5 h-5" />
            <span class="font-medium text-sm">Express</span>
          </a>
          <a href="/testing/playwright-integration/" class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors">
            <Icon name="simple-icons:playwright" class="w-5 h-5" />
            <span class="font-medium text-sm">Playwright</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <nav aria-label="Jump to a section" class="relative z-10 max-w-6xl mx-auto mt-12 lg:mt-10">
    <p class="mb-3 text-sm font-medium text-gray-600 dark:text-gray-400 text-center lg:text-left">Jump to</p>
    <ul class="grid grid-cols-2 lg:grid-cols-4 rounded-2xl border border-gray-200 dark:border-white/10 bg-white/70 dark:bg-white/[0.02] backdrop-blur-sm divide-gray-200 dark:divide-white/10 [&>li]:border-gray-200 dark:[&>li]:border-white/10 [&>li:nth-child(odd)]:border-r lg:[&>li]:border-r lg:[&>li:last-child]:border-r-0 [&>li:nth-child(-n+2)]:border-b lg:[&>li]:border-b-0">
      {chapters.map((c) => (
        <li>
          <a
            href={c.href}
            class:list={[
              'group flex h-full items-start justify-between gap-3 p-4 lg:p-5 rounded-2xl transition-colors',
              c.featured ? 'bg-violet-50/80 dark:bg-violet-500/[0.08] hover:bg-violet-100/70 dark:hover:bg-violet-500/[0.14]' : 'hover:bg-gray-50 dark:hover:bg-white/[0.04]',
            ]}
          >
            <span class="min-w-0">
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-semibold text-gray-900 dark:text-white group-hover:text-violet-700 dark:group-hover:text-violet-300 transition-colors">{c.title}</span>
              </span>
              <span class:list={["mt-1 block text-sm", c.featured ? "text-violet-800 dark:text-violet-200" : "text-gray-600 dark:text-gray-400"]}>{c.blurb}</span>
            </span>
            <svg class="mt-1 w-4 h-4 flex-none text-gray-400 group-hover:text-violet-600 dark:group-hover:text-violet-400 motion-safe:group-hover:translate-y-0.5 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<script>
  // Install command configuration
  const commands: Record<string, Record<string, string>> = {
    nextjs: {
      npm: 'npm install @scenarist/nextjs-adapter msw',
      pnpm: 'pnpm add @scenarist/nextjs-adapter msw',
      yarn: 'yarn add @scenarist/nextjs-adapter msw',
    },
    express: {
      npm: 'npm install @scenarist/express-adapter msw',
      pnpm: 'pnpm add @scenarist/express-adapter msw',
      yarn: 'yarn add @scenarist/express-adapter msw',
    },
  };

  const state = { framework: 'nextjs', pm: 'pnpm' };
  const activeTabClasses = 'bg-white dark:bg-[#27272A] text-gray-900 dark:text-white shadow-sm';
  const inactiveTabClasses = 'text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300';

  const updateCommand = () => {
    const commandEl = document.getElementById('install-command');
    if (commandEl) {
      commandEl.textContent = commands[state.framework][state.pm];
    }
  };

  const setActiveTab = (tabs: NodeListOf<Element>, activeValue: string, dataAttr: string) => {
    tabs.forEach((tab) => {
      const value = tab.getAttribute(dataAttr);
      if (value === activeValue) {
        tab.className = tab.className.replace(inactiveTabClasses, '').trim();
        if (!tab.className.includes(activeTabClasses)) {
          tab.className += ' ' + activeTabClasses;
        }
      } else {
        tab.className = tab.className.replace(activeTabClasses, '').trim();
        if (!tab.className.includes(inactiveTabClasses)) {
          tab.className += ' ' + inactiveTabClasses;
        }
      }
    });
  };

  // Framework tab handlers
  const frameworkTabs = document.querySelectorAll('.framework-tab');
  frameworkTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      state.framework = tab.getAttribute('data-framework') || 'nextjs';
      setActiveTab(frameworkTabs, state.framework, 'data-framework');
      updateCommand();
    });
  });

  // Package manager tab handlers
  const pmTabs = document.querySelectorAll('.pm-tab');
  pmTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      state.pm = tab.getAttribute('data-pm') || 'pnpm';
      setActiveTab(pmTabs, state.pm, 'data-pm');
      updateCommand();
    });
  });

  // Copy install command to clipboard
  document.getElementById('copy-install')?.addEventListener('click', async () => {
    try {
      const command = commands[state.framework][state.pm];
      await navigator.clipboard.writeText(command);
      const button = document.getElementById('copy-install');
      if (button) {
        button.classList.add('copied');
        setTimeout(() => {
          button.classList.remove('copied');
        }, 2000);
      }
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  });
</script>
