---
import LandingLayout from '../layouts/LandingLayout.astro';
import GridBackground from '../components/landing/GridBackground.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import CodeExample from '../components/landing/CodeExample.astro';
import Scenarios from '../components/landing/Scenarios.astro';
import DynamicScenarios from '../components/landing/DynamicScenarios.astro';
import Comparison from '../components/landing/Comparison.astro';
import ValueProps from '../components/landing/ValueProps.astro';
import Features from '../components/landing/Features.astro';
import Community from '../components/landing/Community.astro';
import Footer from '../components/landing/Footer.astro';
---

<LandingLayout
  title="Scenarist | Test Reality. Control the Rest."
  description="Playwright tests where your real backend runs and every external API plays the scenario you choose. Test the declined card, the expired Auth0 session and the 503—not just the happy path. Switch scenarios per test, in parallel, without restarting."
>
  <GridBackground />
  <Nav />
  <main>
    <Hero />
    <CodeExample />
    <Scenarios />
    <DynamicScenarios />
    <Comparison />
    <ValueProps />
    <Features />
    <Community />
  </main>
  <Footer />
</LandingLayout>
