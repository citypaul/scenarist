{
  "name": "scenarist",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:bruno:ci": "turbo run test:bruno:ci",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "license:check": "license-checker --summary --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Unlicense;Python-2.0;BlueOak-1.0.0;MPL-2.0'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json}": "prettier --write"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22 <25"
  }
}
